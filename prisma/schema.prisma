// Prisma schema for the Rent Car platform.
// Prisma 7: rust-free `prisma-client` generator, generated into the source
// tree, connection URL configured in prisma.config.ts (not here).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth / RBAC -----------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  // Stable string key, e.g. "users.view" (matches lib/permissions).
  key       String           @unique
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

// Explicit many-to-many between Role and Permission.
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// --- Branding --------------------------------------------------------------

// Single-row table for now. When multi-tenancy arrives this grows a tenant key.
// Holds brand + contact info shown across the public site. Fields the owner
// hasn't filled in stay null and their UI simply doesn't render (no filler).
model CompanySettings {
  id             String   @id @default(cuid())
  companyName    String
  // Logo shown in the navbar (falls back to the text wordmark when null).
  logoUrl        String?
  // Logo shown in the footer (falls back to logoUrl, then the wordmark).
  footerLogoUrl  String?
  whatsappNumber String
  primaryColor   String?
  contactEmail   String
  // Contact / social (editable from backoffice; optional)
  phone          String?
  instagramUrl   String?
  facebookUrl    String?
  // Location (only shown if an official address is set)
  address        String?
  googleMapsUrl  String?
  // Short "about" text for the Nosotros section (owner-written; optional)
  aboutText      String?
  // Homepage hero: background photo + headline/subtitle (all optional; the
  // hero falls back to sensible defaults when empty).
  heroImageUrl   String?
  heroTitle      String?
  heroSubtitle   String?
  // Logo display scale in the footer (1.0 = default).
  logoScale      Float    @default(1)
  // Logo display scale in the navbar (1.0 = default).
  navLogoScale   Float    @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- Catalog ---------------------------------------------------------------

enum Transmission {
  automatic
  manual
}

enum FuelType {
  gasolina
  diesel
  hibrido
  electrico
}

enum VehicleCategory {
  economico
  compacto
  sedan
  suv
  suv_grande
  premium
}

model Vehicle {
  id           String          @id @default(cuid())
  brand        String
  model        String
  year         Int
  category     VehicleCategory @default(economico)
  // When true, public listings show "<brand> <model> o similar".
  orSimilar    Boolean         @default(true)
  transmission Transmission
  fuelType     FuelType        @default(gasolina)
  passengers   Int
  doors        Int             @default(4)
  dailyPrice   Int // USD per day
  imageUrl     String // cover photo (used in cards)
  // Photo shown in the homepage hero carousel (falls back to imageUrl).
  carouselImageUrl String?
  // Additional real photos for the detail gallery/carousel.
  images       String[]        @default([])
  // Short owner-written description (optional).
  description  String?
  // Amenities / facilities, e.g. "Aire acondicionado", "Bluetooth".
  features     String[]        @default([])
  // Optional custom WhatsApp message for this vehicle. Supports {vehicle}
  // which is replaced by the vehicle title. Empty = use the default message.
  whatsappMessage String?
  isActive     Boolean         @default(true)
  // Detail-page view counter. Drives the "most viewed first" ordering of the
  // public fleet. Incremented server-side when a detail page is opened.
  viewCount    Int             @default(0)
  // Framing data for every photo. Stored as a JSON object keyed by the photo
  // URL (or the special keys "cover" and "carousel"). Each entry holds
  // { x: number, y: number, zoom: number } where x/y are percent offsets
  // (0–100) and zoom is a scale multiplier (1 = fit-width, >1 zooms in).
  // Null means no custom framing has been set (falls back to center/cover).
  imageFits    Json?
  // Dedicated image for documents (reservation confirmation / PDF). Optional;
  // PNG/WebP with transparency, shown COMPLETE (not cropped). When empty, the
  // documents fall back to imageUrl. Independent from the catalog photos.
  documentImageUrl String?
  // Reservations placed for this vehicle (digital booking system).
  reservations Reservation[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive])
  @@index([category])
  @@index([isActive, viewCount])
}

// --- Editable site content (managed from the backoffice) -------------------

// Requirements to rent (licencia, edad, etc.). Owner-written.
model Requirement {
  id        String   @id @default(cuid())
  text      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Delivery / pickup locations (e.g. SDQ airport, Santo Domingo).
model DeliveryLocation {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Real photo of the location (e.g. the airport terminal) shown in the
  // public carousel. Optional — cards fall back to an icon when empty.
  imageUrl    String?
  // Whether this location carries an extra delivery charge. When false the
  // location is free. When true it shows "Cargo adicional"; if deliveryFee > 0
  // the amount is shown and added to the total, otherwise just the label.
  hasFee      Boolean  @default(false)
  // Extra fee (USD) added to the rental total when hasFee is true and > 0.
  deliveryFee Int      @default(0)
  // Optional Google Maps URL to show the exact spot (e.g. airport terminal).
  mapUrl      String?
  // Highlighted locations (e.g. the airport) render more prominently.
  highlighted Boolean  @default(false)
  // Whether this location is an airport. When true, selecting it as the rental
  // pickup/dropoff auto-fills the arrival/return flight airport, so the
  // customer doesn't re-enter it in "Información de vuelo".
  isAirport   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// "Tu renta incluye" items (asistencia, vehículo revisado, etc.).
model Inclusion {
  id        String   @id @default(cuid())
  text      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Vehicle rental policies (no fumar, devolver con combustible, etc.).
model Policy {
  id        String   @id @default(cuid())
  text      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Frequently asked questions. Owner-written; easy to edit later.
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Customer reviews. Prepared for real Google reviews; never seeded with fakes.
model Review {
  id         String   @id @default(cuid())
  authorName String
  rating     Int // 1-5
  comment    String
  reviewDate DateTime?
  avatarUrl  String?
  source     String   @default("google") // provenance label
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// --- Reservations (digital booking system) ---------------------------------

// Lifecycle of a reservation.
//  - link_created: an admin created a shareable link; the customer hasn't
//    filled the form yet. Does NOT hold the vehicle.
//  - pending:      the customer submitted the form; awaiting review/payment.
//  - confirmed:    the reservation is approved/confirmed.
//  - needs_fix:    something is wrong; the customer must correct their data.
enum ReservationStatus {
  link_created
  pending
  confirmed
  needs_fix
  // rejected: request received but not approved.
  rejected
  // cancelled: a reservation that is cancelled afterwards (distinct from rejected).
  cancelled
}

// Where the reservation originated.
enum ReservationSource {
  whatsapp
  instagram
  referido
  recurrente
  otro
  // The customer opened a public/admin-generated link and filled the form.
  link
  // The customer started the reservation from the public vehicle page ("Página web").
  web
}

// Payment method chosen for the reservation deposit.
enum ReservationPaymentMethod {
  zelle
  paypal
  cashapp
  otro
}

model Reservation {
  id                 String            @id @default(cuid())
  // Short, human-friendly code shown to staff/customer (e.g. "JRC-8F3K2A").
  code               String            @unique
  // Secure random token used in the shareable link (/reservar/<token>).
  token              String            @unique

  // Vehicle being reserved.
  vehicleId          String
  vehicle            Vehicle           @relation(fields: [vehicleId], references: [id])

  // --- Customer data (filled from the digital form; optional at link time) ---
  customerName       String?
  email              String?
  phone              String?
  country            String?
  idOrPassport       String?
  driverLicense      String?

  // --- Rental details (optionally pre-filled when creating the link) ---
  pickupDate         DateTime?
  pickupTime         String? // HH:mm
  dropoffDate        DateTime?
  dropoffTime        String? // HH:mm
  pickupLocation     String?
  dropoffLocation    String?

  // --- Pricing (USD, integers) ---
  dailyPrice         Int               @default(0)
  billedDays         Int               @default(0)
  // Rent-only subtotal (dailyPrice * billedDays), before delivery fees.
  subtotalRent       Int               @default(0)
  // Delivery fees resolved from the chosen pickup/dropoff locations.
  pickupFee          Int               @default(0)
  dropoffFee         Int               @default(0)
  // Grand total = subtotalRent + pickupFee + dropoffFee. The deposit is PART
  // of this total, never added on top.
  estimatedTotal     Int               @default(0)
  // Suggested/legacy deposit field (kept for compatibility).
  reservationDeposit Int               @default(0)
  // Amount the customer chose to pay now to secure the reservation (0 = none).
  depositPaid        Int               @default(0)
  // Remaining balance = estimatedTotal - depositPaid.
  balanceDue         Int               @default(0)

  // --- Payment ---
  paymentMethod      ReservationPaymentMethod?
  paymentProofUrl    String?

  source             ReservationSource @default(link)
  status             ReservationStatus @default(link_created)

  // Optional reason recorded when a reservation is rejected. Kept for later
  // use in customer notifications. (Legacy; superseded by statusMessage.)
  rejectionReason    String?

  // Message the admin records when rejecting or requesting a correction. Its
  // visibility to the customer is controlled by statusMessageVisible: when
  // false it is an internal note only.
  statusMessage        String?
  statusMessageVisible Boolean         @default(false)

  // Optional special request written by the customer (e.g. "traveling with a
  // child"). Null/empty = none.
  specialRequest       String?

  // --- Flight information (arrival) — optional, no live tracking yet ---
  hasArrivalFlight      Boolean        @default(false)
  arrivalAirline        String?
  arrivalFlightNumber   String?
  arrivalAirport        String?
  arrivalDate           DateTime?
  arrivalTime           String? // HH:mm
  arrivalItineraryUrl   String?

  // --- Flight information (return) — optional ---
  hasReturnFlight       Boolean        @default(false)
  returnAirline         String?
  returnFlightNumber    String?
  returnAirport         String?
  returnDate            DateTime?
  returnTime            String? // HH:mm
  returnItineraryUrl    String?

  // --- Reservation policy acceptance (the RESERVATION policy, NOT a rental
  //     contract; no digital signature). Validated server-side on submit. ---
  policyAccepted        Boolean        @default(false)
  policyAcceptedAt      DateTime?

  // --- Official confirmation (generated ONLY when the admin confirms) ---
  // Timestamp of the confirmation that produced the current official PDF.
  confirmedAt           DateTime?
  // Public URL of the stored confirmation PDF (Supabase Storage).
  confirmationPdfUrl    String?
  // Immutable snapshot of the data used to render the PDF at confirmation
  // time, so the document never silently changes if the reservation is later
  // edited. Kept as JSON for future revisions/versioning.
  confirmationSnapshot  Json?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Communication history (emails sent for this reservation).
  emailLogs          ReservationEmailLog[]

  @@index([status])
  @@index([vehicleId])
  @@index([createdAt])
}

// Simple communication log: one row per email attempt for a reservation.
// Never stores the API key or unnecessary sensitive content — only metadata
// (type, recipient, subject, result, provider id, optional error).
model ReservationEmailLog {
  id            String              @id @default(cuid())
  reservationId String
  reservation   Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  // Which email this was (request_received, needs_fix, confirmed, rejected, cancelled).
  type          String
  // Recipient address at send time.
  toEmail       String
  subject       String
  // "sent" or "error".
  status        String
  // Resend message id when available.
  providerId    String?
  // Error summary when status = "error" (no secrets).
  error         String?
  createdAt     DateTime            @default(now())

  @@index([reservationId])
  @@index([type])
}

// Single-row settings table for the digital booking system (mirrors the
// CompanySettings singleton pattern). Editable from the admin.
model ReservationSettings {
  id                 String   @id @default(cuid())
  // Master switch. When true, the digital flow is used; when false the site
  // keeps the current WhatsApp flow. NOT wired to the public button yet.
  digitalEnabled     Boolean  @default(false)
  // Default reservation deposit (USD) suggested when creating links (legacy).
  defaultDeposit     Int      @default(0)
  // Configurable deposit amounts (USD) the customer can choose from, e.g.
  // [100, 150]. Editable from the admin. Empty = only "without deposit".
  depositOptions     Int[]    @default([])
  // General payment instructions shown to the customer.
  paymentInstructions String?

  // Zelle
  zelleEnabled       Boolean  @default(false)
  zelleName          String?
  zelleEmail         String?
  zellePhone         String?

  // PayPal
  paypalEnabled      Boolean  @default(false)
  paypalEmail        String?
  paypalLink         String?

  // Cash App
  cashappEnabled     Boolean  @default(false)
  cashappTag         String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Visual template for the reservation confirmation PDF, designed with the
// admin drag & drop builder. The `document` JSON holds the full layout tree
// (rows → columns → elements) as defined by TemplateDocument in
// src/features/reservation-template/types.ts. Only ONE row may be "published"
// at a time (enforced in the server action); a separate "draft" row lets the
// admin save work in progress. NOT yet wired to PDF generation.
model ReservationTemplate {
  id        String   @id @default(cuid())
  // Human name (e.g. "Plantilla principal").
  name      String   @default("Plantilla de reserva")
  // "draft" | "published".
  status    String   @default("draft")
  // The layout tree (TemplateDocument) as JSON.
  document  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
