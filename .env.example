# Copia este archivo a .env.local (local) y configura las mismas variables en
# Vercel (Project → Settings → Environment Variables). NO subas valores reales.

# --- Supabase (cliente / auth futura) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- PostgreSQL (Supabase) para Prisma ---
# DATABASE_URL: usa el TRANSACTION POOLER (puerto 6543) para la app en runtime
#   en serverless (Vercel). Añade ?pgbouncer=true&connection_limit=1
# DIRECT_URL:   conexión DIRECTA / SESSION POOLER (puerto 5432) para migraciones.
# Ambas cadenas las obtienes en Supabase → Connect → ORMs.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# --- Auth.js (NextAuth v5) ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
# En producción, la URL pública del sitio (Vercel la infiere, pero es seguro fijarla).
# AUTH_URL="https://tu-dominio.com"

# --- Supabase Storage (subida de imágenes desde el servidor) ---
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="media"
